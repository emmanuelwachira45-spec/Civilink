        android:pathData="M44,34 h14 v40 h-14 z M47.5,41 h4 v4.5 h-4 z M53.5,41 h4 v4.5 h-4 z M47.5,51 h4 v4.5 h-4 z M53.5,51 h4 v4.5 h-4 z M47.5,61 h4 v4.5 h-4 z M53.5,61 h4 v4.5 h-4 z"/>

