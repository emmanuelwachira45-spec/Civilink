        android:pathData="M51,23 L51,34"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeColor="#FFF4F9FE"/>

    <!-- Beacon -->
    <path
        android:pathData="M51,21.5 m-2,0 a2,2 0 1,1 4,0 a2,2 0 1,1 -4,0"
        android:fillColor="#FF4FC3F7"/>

    <!-- Right high-rise (sky accent) with lit slit -->
    <path
        android:fillColor="#FF4FC3F7"
        android:pathData="M62,43 h10 v31 h-10 z"/>
    <path
        android:fillColor="#FF10375C"
        android:pathData="M65.5,50 h3.2 v4 h-3.2 z"/>
    <path
        android:fillColor="#F0FFFFFF"
        android:pathData="M65.5,58 h3.2 v4 h-3.2 z"/>
